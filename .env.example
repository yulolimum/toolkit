# Linear API Key - Get from https://linear.app/settings/api
LINEAR_API_KEY=

# Clockify API Key - Get from https://clockify.me/user/settings
CLOCKIFY_API_KEY=

# OpenRouter API Key - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Twitch API Credentials - Get from https://dev.twitch.tv/console/apps
# Create a new application and use the Client ID and Client Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch Streamlink OAuth Token - Static OAuth token for streamlink
# This is different from the API token above - it's used specifically for streamlink to bypass ads
# https://streamlink.github.io/cli/plugins/twitch.html
TWITCH_STREAMLINK_OAUTH=
