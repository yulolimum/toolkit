{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.x.x",
      "pnpm": "10.x.x",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false
      },
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production"
      },
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "environment": "development",
      "autoIncrement": false,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    "preview:pr-__pr_number__": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "pr-__pr_number__",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview:internal": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "store",
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleTeamId": "<--APPLE_TEAM_ID-->",
        "ascAppId": "<--ASC_APP_ID-->"
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleTeamId": "<--APPLE_TEAM_ID-->",
        "ascAppId": "<--ASC_APP_ID-->"
      }
    }
  }
}
